# Renomeie para .env.local e preencha.
# Supabase -> Connect ou Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_publishable_key

# Senha para gravar medicao e ocorrencias. Fica so no servidor,
# nao vai para o navegador. Escolha uma e passe a quem vai medir.
SENHA_MEDICAO=troque_esta_senha
