# Renomeie para .env.local e preencha.
# Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave secreta (sb_secret_...). Fica so no servidor (rotas /api), nunca no navegador.
SUPABASE_SECRET_KEY=cole_aqui_a_secret_key

# Senha da obra: grava medicao, lancamentos e ocorrencias e abre as abas
# Medicao semanal e Lancamentos. Fica so no servidor, nao vai para o navegador.
SENHA_MEDICAO=troque_esta_senha
